<!DOCTYPE html>
<html lang="de">

<head>
  <meta charset="UTF-8">
  <meta name="robots" content="noindex, nofollow, noarchive">
  <meta name="googlebot" content="noindex, nofollow, noarchive">
  <title>Analytics deaktiviert</title>
</head>

<body>

  <script>
    localStorage.setItem('cloudflare-analytics-disabled', 'true');
    window.location.replace('{{ "/" | url }}');
  </script>

  <noscript>
    <p>JavaScript ist deaktiviert. Bitte aktiviere JavaScript, um Analytics für diesen Browser zu deaktivieren.</p>
  </noscript>

</body>

</html>

<!DOCTYPE html>
<html lang="de">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  {% include "favicons.njk" %}

  <title>{{ title }} – Dr. Methodius</title>

  {%- set seitenBeschreibung = description or site.description %}
  {%- set seitenBild = site.url + (ogImage or site.image) %}
  {%- set seitenUrl = site.url + page.url %}

  <meta name="description" content="{{ seitenBeschreibung }}">
  <link rel="canonical" href="{{ seitenUrl }}">

  {%- if robots %}
  <meta name="robots" content="{{ robots }}">
  {%- endif %}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="{{ site.name }}">
  <meta property="og:locale" content="de_DE">
  <meta property="og:title" content="{{ ogTitle or title }} – {{ site.name }}">
  <meta property="og:description" content="{{ seitenBeschreibung }}">
  <meta property="og:url" content="{{ seitenUrl }}">

  {%- set karte = ogCard or "summary" %}

  <meta name="twitter:card" content="{{ karte }}">
  <meta property="og:image" content="{{ seitenBild }}">
  <meta property="og:image:width" content="{{ ogImageWidth or 256 }}">
  <meta property="og:image:height" content="{{ ogImageHeight or 256 }}">
  <meta property="og:image:alt" content="{{ ogImageAlt or title }}">

  <link rel="stylesheet" href="{{ '/style.css' | url }}">
  {%- for css in extraCss %}
  <link rel="stylesheet" href="{{ ('/css/' + css) | url }}">
  {%- endfor %}
</head>

<body>

  {% include "header.njk" %}

  {{ content | safe }}

  {% include "footer.njk" %}

  <script src="{{ '/js/menu.js' | url }}"></script>
  {%- for js in vendorJs %}
  <script src="{{ ('/vendor/' + js) | url }}"></script>
  {%- endfor %}
  {%- for js in extraJs %}
  <script src="{{ ('/js/' + js) | url }}"></script>
  {%- endfor %}

  {%- if tally %}
  <script async src="https://tally.so/widgets/embed.js"></script>
  {%- endif %}
  
  <!-- Cloudflare Web Analytics – für diesen Browser deaktivierbar -->
  <script>
    if (localStorage.getItem('cloudflare-analytics-disabled') !== 'true') {
      const script = document.createElement('script');
      script.type = 'module';
      script.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      script.setAttribute( 'data-cf-beacon', '{"token": "679788a899d74b3dafba5e1e1e1651cc"}' );
      document.body.appendChild(script);
    }
  </script>

</body>

</html>
